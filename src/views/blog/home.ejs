<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Muslimah Produktif · Kanvas Motivasi & Hijrah</title>
  <!-- Google Fonts: Elegant & Premium Typography -->
  <link
    href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Cormorant+Garamond:wght@400;500;600;700&display=swap"
    rel="stylesheet">
  <!-- Font Awesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Plus Jakarta Sans', system-ui, -apple-system, 'Segoe UI', sans-serif;
      background: #FFFBF7;
      color: #2C2A29;
      line-height: 1.5;
      overflow-x: hidden;
    }

    /* container mewah */
    .home-container {
      max-width: 1440px;
      margin: 0 auto;
      padding: 2rem 2rem 2.5rem;
    }

    /* ========== HERO SECTION ELEGAN (tanpa navbar, tanpa tombol komunitas / tulis inspirasi) ========== */
    .hero-luxury {
      background: linear-gradient(125deg, #FCF4EC 0%, #FEF8F2 40%, #F9EFE6 100%);
      border-radius: 2.8rem;
      padding: 3.2rem 3rem 2.8rem;
      margin-bottom: 3rem;
      position: relative;
      overflow: hidden;
      border: 1px solid #F0E2D4;
      box-shadow: 0 22px 40px -14px rgba(80, 58, 42, 0.08);
      text-align: center;
    }

    .hero-luxury::before {
      content: "☾";
      font-size: 280px;
      position: absolute;
      bottom: -70px;
      left: -30px;
      opacity: 0.05;
      color: #D6B28C;
      pointer-events: none;
      font-family: serif;
    }

    .hero-luxury::after {
      content: "🌿";
      font-size: 180px;
      position: absolute;
      top: -30px;
      right: 15px;
      opacity: 0.05;
      pointer-events: none;
    }

    .hero-badge {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: rgba(255, 250, 242, 0.9);
      backdrop-filter: blur(8px);
      padding: 0.45rem 1.8rem;
      border-radius: 60px;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.3em;
      color: #B2825C;
      margin-bottom: 1.2rem;
      border: 0.5px solid #E7D6C7;
    }

    .hero-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: 4.2rem;
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.2;
      max-width: 85%;
      margin: 0 auto;
      color: #3E2C20;
    }

    .hero-title span {
      background: linear-gradient(125deg, #C6A27C, #A37F5A);
      background-clip: text;
      -webkit-background-clip: text;
      color: transparent;
    }

    .hero-desc {
      margin-top: 1rem;
      font-size: 1.05rem;
      color: #7A624E;
      max-width: 65%;
      margin-left: auto;
      margin-right: auto;
    }

    /* value pillars - lebih banyak konten motivasi */
    .value-pillars {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 2rem;
      margin-bottom: 3rem;
    }

    .pillar-card {
      background: #FFFFFFF0;
      backdrop-filter: blur(2px);
      border-radius: 2rem;
      padding: 1.8rem 1.2rem;
      text-align: center;
      border: 1px solid #F0E2D6;
      transition: all 0.3s ease;
      box-shadow: 0 8px 18px rgba(0, 0, 0, 0.02);
    }

    .pillar-card:hover {
      transform: translateY(-5px);
      border-color: #E1CFBF;
      background: #FFFFFF;
    }

    .pillar-card i {
      font-size: 2.2rem;
      color: #D0AE8B;
      margin-bottom: 0.9rem;
    }

    .pillar-card h4 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.3rem;
      font-weight: 600;
      color: #5B4433;
    }

    .pillar-card p {
      font-size: 0.85rem;
      color: #8E705B;
      margin-top: 0.5rem;
    }

    /* SLIDER HORIZONTAL PREMIUM - artikel menggeser ke samping */
    .slider-section {
      margin-bottom: 2rem;
    }

    .section-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
      margin-bottom: 1.2rem;
    }

    .section-header h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2rem;
      font-weight: 600;
      color: #4B3525;
    }

    .slider-wrapper {
      position: relative;
      width: 100%;
      overflow-x: hidden;
      border-radius: 1.8rem;
      padding: 0 3.6rem;
    }

    .slider-track {
      display: flex;
      gap: 2rem;
      overflow-x: auto;
      scroll-behavior: smooth;
      scrollbar-width: thin;
      padding-bottom: 1rem;
      cursor: grab;
    }

    .slider-track::-webkit-scrollbar {
      height: 6px;
    }

    .slider-track::-webkit-scrollbar-track {
      background: #F2E5DB;
      border-radius: 12px;
    }

    .slider-track::-webkit-scrollbar-thumb {
      background: #DCBFA6;
      border-radius: 12px;
    }

    /* Horizontal Cards Premium */
    .post-card-horizontal {
      flex: 0 0 350px;
      background: #FFFFFF;
      border-radius: 2rem;
      overflow: hidden;
      transition: all 0.35s cubic-bezier(0.2, 0, 0, 1);
      border: 1px solid #F0E2D6;
      box-shadow: 0 16px 28px -12px rgba(70, 48, 34, 0.08);
      display: flex;
      flex-direction: column;
    }

    .post-card-horizontal:hover {
      transform: translateY(-8px);
      box-shadow: 0 28px 38px -14px rgba(87, 60, 44, 0.2);
      border-color: #E1CEBC;
    }

    .card-img {
      aspect-ratio: 16/9;
      background: #F3E8DF;
      overflow: hidden;
    }

    .card-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.45s ease;
    }

    .post-card-horizontal:hover .card-img img {
      transform: scale(1.04);
    }

    .card-body {
      padding: 1.4rem 1.4rem 1.6rem;
      flex: 1;
      display: flex;
      flex-direction: column;
    }

    .category-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #FCF3EA;
      padding: 0.2rem 1rem;
      border-radius: 30px;
      font-size: 0.65rem;
      font-weight: 700;
      letter-spacing: 0.2px;
      color: #B78963;
      width: fit-content;
    }

    .card-title {
      font-size: 1.25rem;
      font-weight: 700;
      font-family: 'Cormorant Garamond', serif;
      line-height: 1.35;
      margin: 0.7rem 0 0.5rem;
    }

    .card-title a {
      text-decoration: none;
      color: #433328;
      transition: color 0.2s;
    }

    .card-title a:hover {
      color: #B5815B;
    }

    .excerpt-sm {
      font-size: 0.8rem;
      line-height: 1.5;
      color: #7C6452;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin: 0.3rem 0 0.8rem;
    }

    .meta-horizontal {
      display: flex;
      justify-content: space-between;
      font-size: 0.7rem;
      font-weight: 500;
      color: #B3967D;
      border-top: 1px solid #F0E2D4;
      padding-top: 0.8rem;
      margin-top: auto;
    }

    /* SLIDER BUTTONS DI DALAM WRAPPER (kiri/kanan tengah vertikal) */
    .slider-controls-bottom {
      position: absolute;
      top: 50%;
      left: 0;
      right: 0;
      transform: translateY(-50%);
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0 0.8rem;
      pointer-events: none;
      z-index: 4;
    }

    .slider-btn-bottom {
      background: #FFFFFF;
      border: 1px solid #E2D0C0;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      cursor: pointer;
      transition: all 0.2s;
      color: #B18664;
      font-size: 1.1rem;
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.02);
      pointer-events: auto;
    }

    .slider-btn-bottom:hover {
      background: #FCF3EA;
      border-color: #CFB99F;
      transform: scale(1.03);
    }

    /* KATEGORI & TAGS POPULER (dipertahankan, lebih kaya) */
    .categories-tags-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
      margin: 2.5rem 0 2rem;
    }

    .premium-card {
      background: #FFFFFF;
      border-radius: 2rem;
      padding: 1.8rem;
      border: 1px solid #F0E2D6;
      transition: all 0.2s;
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.02);
    }

    .premium-card h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.5rem;
      font-weight: 600;
      color: #4F3A2A;
      margin-bottom: 1.2rem;
      display: flex;
      align-items: center;
      gap: 10px;
      border-bottom: 2px solid #F1E3D8;
      padding-bottom: 0.6rem;
    }

    .tag-group,
    .category-group {
      display: flex;
      flex-wrap: wrap;
      gap: 0.8rem;
    }

    .pill-link {
      background: #FEF7F2;
      padding: 0.5rem 1.2rem;
      border-radius: 3rem;
      font-size: 0.75rem;
      font-weight: 500;
      text-decoration: none;
      color: #7E624C;
      transition: all 0.2s;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      border: 0.5px solid #F2E4DA;
    }

    .pill-link:hover {
      background: #FAEFE5;
      color: #B0805B;
      transform: translateY(-2px);
    }

    /* Daily Quote & motivasi tambahan */
    .daily-quote {
      background: #FEF9F2;
      border-radius: 2rem;
      padding: 2rem;
      margin: 2rem 0 0;
      text-align: center;
      border: 1px solid #EBDACB;
    }

    /* Pagination Modern */
    .pagination-modern {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.7rem;
      margin-top: 2rem;
      flex-wrap: wrap;
    }

    .pagination-modern a,
    .pagination-modern span {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.5rem;
      height: 2.5rem;
      padding: 0 0.9rem;
      border-radius: 2.2rem;
      font-size: 0.85rem;
      font-weight: 500;
      text-decoration: none;
      background: #FFFFFF;
      color: #826952;
      border: 1px solid #EADBCE;
    }

    .pagination-modern .active-page {
      background: #E2CFBD;
      color: #4A3324;
      border-color: #CFB69D;
    }

    /* Footer minimal (tanpa teks Muslimah Produktif · 2025 dan Berkah & Hijrah) */
    .footer-simple {
      margin-top: 3rem;
      background: #FFF9F4;
      border-radius: 2rem;
      padding: 1.8rem;
      text-align: center;
      border: 1px solid #EDE0D4;
      color: #B1957C;
      font-size: 0.8rem;
    }

    .footer-simple i {
      margin: 0 6px;
    }

    @media (max-width: 880px) {
      .home-container {
        padding: 1rem;
      }

      .hero-title {
        font-size: 2.4rem;
        max-width: 100%;
      }

      .hero-desc {
        max-width: 100%;
      }

      .post-card-horizontal {
        flex: 0 0 290px;
      }

      .categories-tags-grid {
        grid-template-columns: 1fr;
      }

      .slider-wrapper {
        padding: 0 2.9rem;
      }

      .slider-btn-bottom {
        width: 40px;
        height: 40px;
        font-size: 0.95rem;
      }
    }
  </style>
</head>

<body>
  <div class="home-container">
    <!-- HERO SECTION ELEGAN (tanpa navbar, tanpa tombol aksi Tulis Inspirasi / Komunitas) -->
    <div class="hero-luxury">
      <div class="hero-badge"><i class="fas fa-feather-alt"></i> MUSLIMAH PRODUKTIF · MOTIVASI & HIJRAH</div>
      <h1 class="hero-title">Bangun semangat baru, <span>raih keberkahan</span> dalam setiap langkah</h1>
      <p class="hero-desc">Ruang spesial untuk muslimah yang ingin terus termotivasi, berkembang, dan menginspirasi
        dunia dengan nilai-nilai islami.</p>
    </div>

    <!-- VALUE PILLARS: materi motivasi islami yang lebih kaya -->
    <div class="value-pillars">
      <div class="pillar-card"><i class="fas fa-heart"></i>
        <h4>Ikhlas & Barokah</h4>
        <p>Setiap niat karena Allah, produktivitas menjadi ibadah</p>
      </div>
      <div class="pillar-card"><i class="fas fa-chart-line"></i>
        <h4>Target & Tawakal</h4>
        <p>Rencanakan dengan ikhtiar, serahkan hasil pada Rabb</p>
      </div>
      <div class="pillar-card"><i class="fas fa-hands-helping"></i>
        <h4>Muslimah Berdaya</h4>
        <p>Bangun impian, kelola waktu, dan jadi teladan</p>
      </div>
      <div class="pillar-card"><i class="fas fa-book-quran"></i>
        <h4>Inspirasi Qur’ani</h4>
        <p>Kisah-kisah motivasi dari generasi terbaik umat</p>
      </div>
    </div>

    <!-- SLIDER ARTIKEL HORIZONTAL (tanpa search) -->
    <div class="slider-section">
      <div class="section-header">
        <h2><i class="fas fa-scroll" style="color:#C6A27C; margin-right: 0.6rem;"></i> Artikel Motivasi Pilihan</h2>
      </div>
      <div class="slider-wrapper">
        <div class="slider-track" id="sliderTrack">
          <% if (typeof posts !=='undefined' && posts && posts.length) { posts.forEach((post)=> { %>
            <div class="post-card-horizontal">
              <div class="card-img">
                <% if (post.featuredImage) { %>
                  <img src="<%= post.featuredImage %>" alt="<%= post.title %>" loading="lazy" />
                  <% } else { %>
                    <div
                      style="background: #F2E3D8; height:100%; display: flex; align-items: center; justify-content: center; color:#CBB094;">
                      <i class="fas fa-book-quran fa-2x"></i></div>
                    <% } %>
              </div>
              <div class="card-body">
                <span class="category-chip"><i class="fas fa-tag"></i>
                  <%= post.status ? post.status.toUpperCase() : 'INSPIRASI' %>
                </span>
                <h3 class="card-title"><a href="/posts/<%= post.slug %>" target="_blank" rel="noopener noreferrer">
                    <%= post.title %>
                  </a></h3>
                <p class="excerpt-sm">
                  <%= post.subheadline || post.excerpt || (post.content ? post.content.replace(/<[^>]*>/g, '').slice(0,
                    100) : 'Kisah motivasi untuk muslimah produktif penuh semangat') %>
                </p>
                <div class="meta-horizontal">
                  <span><i class="far fa-clock"></i>
                    <%= post.readingTime || '3' %> menit
                  </span>
                  <span><i class="fas fa-eye"></i>
                    <%= post.viewCount || 0 %> views
                  </span>
                </div>
              </div>
            </div>
            <% }) } else { %>
              <!-- Konten default yang lebih panjang agar tidak kosong, tetap sesuai tema motivasi -->
              <div class="post-card-horizontal">
                <div class="card-img">
                  <div
                    style="background:#EEDDCB; height:100%; display:flex; align-items:center; justify-content:center;">
                    <i class="fas fa-mosque fa-3x" style="color:#C7A27B;"></i></div>
                </div>
                <div class="card-body"><span class="category-chip"><i class="fas fa-star"></i> MOTIVASI</span>
                  <h3 class="card-title"><a href="#">Istikamah di Jalan Hijrah</a></h3>
                  <p class="excerpt-sm">Langkah kecil yang konsisten lebih baik daripada bersemangat lalu putus asa.
                    Yuk, temukan ritme produktif.</p>
                  <div class="meta-horizontal"><span>5 menit</span><span>❤️ 124</span></div>
                </div>
              </div>
              <div class="post-card-horizontal">
                <div class="card-img">
                  <div
                    style="background:#F2E2D4; height:100%; display:flex; align-items:center; justify-content:center;">
                    <i class="fas fa-hijab fa-3x" style="color:#C7A27B;"></i></div>
                </div>
                <div class="card-body"><span class="category-chip">PRODUKTIVITAS</span>
                  <h3 class="card-title"><a href="#">Morning Barakah Routine</a></h3>
                  <p class="excerpt-sm">Bangun pagi, shalat dhuha, dan atur target harian. Kunci keberkahan waktu ala
                    muslimah produktif.</p>
                  <div class="meta-horizontal"><span>4 menit</span><span>⭐ 210</span></div>
                </div>
              </div>
              <div class="post-card-horizontal">
                <div class="card-img">
                  <div
                    style="background:#F5E8DE; height:100%; display:flex; align-items:center; justify-content:center;">
                    <i class="fas fa-hand-sparkles fa-3x" style="color:#C7A27B;"></i></div>
                </div>
                <div class="card-body"><span class="category-chip">SELF GROWTH</span>
                  <h3 class="card-title"><a href="#">Muslimah & Financial Freedom</a></h3>
                  <p class="excerpt-sm">Kelola keuangan syariah, bangun usaha dari rumah, dan jadilah enterpreneur yang
                    barokah.</p>
                  <div class="meta-horizontal"><span>6 menit</span><span>💰 342</span></div>
                </div>
              </div>
              <div class="post-card-horizontal">
                <div class="card-img">
                  <div
                    style="background:#EDDDD0; height:100%; display:flex; align-items:center; justify-content:center;">
                    <i class="fas fa-feather-alt fa-3x" style="color:#C7A27B;"></i></div>
                </div>
                <div class="card-body"><span class="category-chip">INSPIRASI</span>
                  <h3 class="card-title"><a href="#">Kisah Hijrah Aisyah</a></h3>
                  <p class="excerpt-sm">Dari zona nyaman menuju pribadi lebih baik. Perjalanan spiritual yang
                    menggetarkan hati.</p>
                  <div class="meta-horizontal"><span>7 menit</span><span>📖 450</span></div>
                </div>
              </div>
              <% } %>
        </div>
        <div class="slider-controls-bottom">
          <button class="slider-btn-bottom" id="slideLeftBottom"><i class="fas fa-chevron-left"></i></button>
          <button class="slider-btn-bottom" id="slideRightBottom"><i class="fas fa-chevron-right"></i></button>
        </div>
      </div>
    </div>

    <!-- PAGINATION (tetap dipertahankan) -->
    <% if (typeof pagination !=='undefined' && pagination && pagination.totalPages> 1) { %>
      <div class="pagination-modern">
        <% if (pagination.hasPrev) { %>
          <a href="?page=<%= pagination.prevPage %>"><i class="fas fa-chevron-left"></i> Sebelumnya</a>
          <% } else { %>
            <span><i class="fas fa-chevron-left"></i> Sebelumnya</span>
            <% } %>
              <% let startPage=Math.max(1, pagination.currentPage - 2); let endPage=Math.min(pagination.totalPages,
                pagination.currentPage + 2); if (endPage - startPage < 4) { if (startPage> 1) startPage = Math.max(1,
                endPage - 4); if (endPage < pagination.totalPages) endPage=Math.min(pagination.totalPages, startPage +
                  4); } for (let p=startPage; p <=endPage; p++) { %>
                  <% if (p===pagination.currentPage) { %>
                    <span class="active-page">
                      <%= p %>
                    </span>
                    <% } else { %>
                      <a href="?page=<%= p %>">
                        <%= p %>
                      </a>
                      <% } } %>
                        <% if (pagination.hasNext) { %>
                          <a href="?page=<%= pagination.nextPage %>">Selanjutnya <i
                              class="fas fa-chevron-right"></i></a>
                          <% } else { %>
                            <span>Selanjutnya <i class="fas fa-chevron-right"></i></span>
                            <% } %>
      </div>
      <% } %>

        <!-- KATEGORI & TAGS POPULER (tidak dihapus, malah diperkaya + konten lebih banyak) -->
        <div class="categories-tags-grid">
          <!-- Kategori widget -->
          <div class="premium-card">
            <h3><i class="fas fa-folder-tree" style="color:#CAA27D;"></i> Kategori Inspirasi</h3>
            <div class="category-group">
              <% if (typeof categories !=='undefined' && categories && categories.length) { %>
                <% categories.forEach((category)=> { %>
                  <a href="/categories/<%= category.slug %>" class="pill-link"><i class="fas fa-tag"></i>
                    <%= category.name %>
                  </a>
                  <% }) %>
                    <% } else { %>
                      <a href="#" class="pill-link"><i class="fas fa-heart"></i> Hijrah & Spiritual</a>
                      <a href="#" class="pill-link"><i class="fas fa-chart-simple"></i> Produktivitas Muslimah</a>
                      <a href="#" class="pill-link"><i class="fas fa-briefcase"></i> Entrepreneur Berkah</a>
                      <a href="#" class="pill-link"><i class="fas fa-brain"></i> Self Love Islami</a>
                      <a href="#" class="pill-link"><i class="fas fa-clock"></i> Time Management</a>
                      <a href="#" class="pill-link"><i class="fas fa-hand-peace"></i> Parenting & Keluarga</a>
                      <% } %>
            </div>
          </div>
          <!-- Tags populer (diperkaya jumlahnya) -->
          <div class="premium-card">
            <h3><i class="fas fa-hashtag" style="color:#CAA27D;"></i> Tags Populer</h3>
            <div class="tag-group">
              <% if (typeof tags !=='undefined' && tags && tags.length) { %>
                <% tags.forEach((tag)=> { %>
                  <a href="/tags/<%= tag.slug %>" class="pill-link">#<%= tag.name %></a>
                  <% }) %>
                    <% } else { %>
                      <span class="pill-link">#ProduktivitasBerkah</span>
                      <span class="pill-link">#HijrahMindset</span>
                      <span class="pill-link">#MuslimahCareer</span>
                      <span class="pill-link">#MorningBarokah</span>
                      <span class="pill-link">#Sisterhood</span>
                      <span class="pill-link">#IslamicProductivity</span>
                      <span class="pill-link">#TahajudChallenge</span>
                      <span class="pill-link">#WirausahaMuslimah</span>
                      <span class="pill-link">#SelfReminder</span>
                      <% } %>
            </div>
          </div>
        </div>

